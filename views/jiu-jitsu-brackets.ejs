}
.venue-summary {
    display: flex;
    justify-content: space-around;
    padding: 10px 8px;
    margin-top: 8px;
    border-top: 1px solid #ebeef5;
    font-size: 12px;
    color: #606266;
    background: #f5f7fa;
    border-radius: 4px;
}
.brackets-main {
    flex: 1;
    min-width: 0;
}
</style>
