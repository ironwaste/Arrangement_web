    color: #f56c6c;
    font-weight: bold;
    font-size: 11px;
}
.venue-allocation-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.venue-group {
    margin-bottom: 8px;
    min-height: 30px;
}
.venue-group-header {
    font-size: 13px;
    font-weight: bold;
    color: #409eff;
    padding: 4px 8px;
    background: #ecf5ff;
    border-radius: 4px;
    margin-bottom: 4px;
}
.venue-class-item {
    padding: 5px 10px;
    background: #fff;
    border: 1px solid #d9ecff;
    border-radius: 4px;
    font-size: 12px;
    color: #303133;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.venue-class-item .venue-info {
    color: #409eff;
