<div class="card">
    <div class="card-header">
        <h2>赛事列表</h2>
        <div class="toolbar" style="margin: 0;">
            <button class="btn btn-primary" onclick="showEventModal()">➕ 新增赛事</button>
            <button class="btn btn-default" onclick="loadEvents()">🔄 刷新</button>
        </div>
    </div>
    <div class="table-container">
        <table id="eventsTable">
            <thead>
                <tr>
                    <th>选择</th>
                    <th data-col="name">赛事名称</th>
                    <th data-col="eventType">赛事类型</th>
                    <th data-col="venue">场馆</th>
                    <th data-col="compTime">比赛时间</th>
                    <th data-col="status">状态</th>
                    <th>修改</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody id="eventsTableBody"></tbody>
        </table>
    </div>
</div>
