</style>

<!-- 竞赛方式配置弹窗 -->
<div id="competitionModeModal" class="modal" style="display:none; position:fixed; z-index:1000; left:0; top:0; width:100%; height:100%; background-color:rgba(0,0,0,0.5);">
    <div class="modal-content" style="background-color:#fefefe; margin:3% auto; padding:20px; border:1px solid #888; width:90%; max-width:1000px; border-radius:8px; max-height:85vh; overflow-y:auto;">
        <div class="modal-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; padding-bottom:10px; border-bottom:2px solid #409eff;">
            <h2>🎲 级别竞赛方式配置</h2>
            <span class="close" onclick="closeCompetitionModeModal()" style="color:#aaa; font-size:28px; font-weight:bold; cursor:pointer;">&times;</span>
        </div>
        <div class="modal-body">
            <div class="alert alert-info" style="background:#ecf5ff; border:1px solid #d9ecff; color:#606266; padding:10px 15px; border-radius:4px; margin-bottom:15px; font-family:'Microsoft YaHei','SimHei',sans-serif;">
                <strong>竞赛方式说明：</strong>
                <ul style="margin:5px 0; padding-left:20px;">
                    <li><strong>单循环赛</strong>：每人都与其他所有人比赛一场</li>
                    <li><strong>分区循环赛</strong>：将运动员分为两组进行循环赛，各组第一名进入决赛</li>
                    <li><strong>单败淘汰赛</strong>：输一场即淘汰，直到决出冠军</li>
                </ul>
            </div>
            <table class="table" style="width:100%; border-collapse:collapse;">
                <thead>
                    <tr style="background:#f5f7fa;">
                        <th style="padding:10px; border:1px solid #dcdfe6; text-align:left;">级别</th>
                        <th style="padding:10px; border:1px solid #dcdfe6; text-align:center;">人数</th>
                        <th style="padding:10px; border:1px solid #dcdfe6; text-align:center;">推荐方式</th>
                        <th style="padding:10px; border:1px solid #dcdfe6; text-align:center;">选择方式</th>
                        <th style="padding:10px; border:1px solid #dcdfe6; text-align:center;">详情</th>
                    </tr>
                </thead>
                <tbody id="competitionModeTableBody">
                </tbody>
            </table>
        </div>
        <div class="modal-footer" style="display:flex; gap:10px; justify-content:flex-end; margin-top:20px; padding-top:15px; border-top:1px solid #ebeef5;">
            <button class="btn btn-default" onclick="closeCompetitionModeModal()">取消</button>
            <button class="btn btn-primary" onclick="saveCompetitionModes()">保存配置</button>
        </div>
    </div>
</div>

<!-- 竞赛方式详情弹窗 -->
<div id="competitionModeDetailModal" class="modal" style="display:none; position:fixed; z-index:1001; left:0; top:0; width:100%; height:100%; background-color:rgba(0,0,0,0.5);">
    <div class="modal-content" style="background-color:#fefefe; margin:5% auto; padding:20px; border:1px solid #888; width:80%; max-width:600px; border-radius:8px;">
        <div class="modal-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h3 id="competitionModeDetailTitle">竞赛方式详情</h3>
            <span class="close" onclick="closeCompetitionModeDetail()" style="color:#aaa; font-size:28px; font-weight:bold; cursor:pointer;">&times;</span>
        </div>
        <div class="modal-body" id="competitionModeDetailContent">
        </div>
        <div class="modal-footer" style="display:flex; justify-content:flex-end; margin-top:20px;">
            <button class="btn btn-default" onclick="closeCompetitionModeDetail()">关闭</button>
        </div>
    </div>
</div>

