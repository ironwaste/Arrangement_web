<div class="card">
    <div class="card-header">
        <h2>摔跤编排</h2>
        <div class="toolbar" style="margin: 0;">
            <input type="file" id="testArrangeImportFile" accept=".xls,.xlsx" style="display:none;" onchange="handleTestArrangeImport(event)">
            <button class="btn btn-info" onclick="document.getElementById('testArrangeImportFile').click()">📥 导入数据</button>
            <button class="btn btn-warning" onclick="exportTestArrangeData()">📤 导出数据</button>
            <button class="btn btn-primary" onclick="saveTestAutoArrange()">💾 保存</button>
            <button class="btn btn-success" onclick="executeTestAutoArrange()">🤖 执行编排</button>
            <button class="btn btn-secondary" onclick="switchToTestManualArrange()">✏️ 手工编排</button>
            <button class="btn btn-info" onclick="showCompetitionModeConfig()">🎲 级别竞赛方式</button>
            <button class="btn btn-danger" onclick="clearTestArrange()">🗑️ 清除编排</button>
        </div>
    </div>
    <div class="brackets-layout">
        <div class="brackets-sidebar">
            <div class="sidebar-header">
                <h3>📋 待编排级别</h3>
                <span id="testPendingCount" class="pending-badge">0</span>
            </div>
            <div id="testPendingClassList" class="pending-class-list"></div>
        </div>
        <div class="brackets-sidebar">
            <div class="sidebar-header">
                <h3>场地分配</h3>
                <div style="display:flex;gap:4px;align-items:center;">
                    <select id="testVenueFilter" onchange="filterTestVenueAllocation()" style="font-size:12px;padding:2px 6px;border:1px solid #dcdfe6;border-radius:3px;">
                        <option value="">全部</option>
                    </select>
                    <button onclick="resetTestVenueFilter()" style="font-size:11px;padding:2px 8px;border:1px solid #dcdfe6;border-radius:3px;background:#fff;cursor:pointer;color:#606266;" title="重置筛选">🔄</button>
                </div>
            </div>
            <div id="testVenueAllocationList" class="venue-allocation-list"></div>
        </div>
        <div class="brackets-main">
            <div class="auto-arrange-table-wrapper">
                <table class="auto-arrange-table">
                    <thead>
                        <tr>
                            <th>序号</th>
                            <th>轮次</th>
                            <th>场次</th>
                            <th>顺序</th>
                            <th>场地</th>
                            <th>单元</th>
                            <th>级别</th>
                            <th>人数</th>
                            <th>总场次</th>
                            <th>决赛</th>
                            <th id="dynamicRoundHeader1">轮次1</th>
                            <th id="dynamicRoundHeader2">轮次2</th>
                            <th id="dynamicRoundHeader3">轮次3</th>
                            <th id="dynamicRoundHeader4">轮次4</th>
                            <th id="dynamicRoundHeader5">轮次5</th>
                            <th id="dynamicRoundHeader6">轮次6</th>
                            <th id="dynamicRoundHeader7">轮次7</th>
                            <th id="dynamicRoundHeader8">轮次8</th>
                            <th>Gold</th>
                            <th>Silver</th>
                            <th>Bronze</th>
                            <th>Rep.</th>
                        </tr>
                    </thead>
                    <tbody id="testAutoArrangeTableBody"></tbody>
                </table>
            </div>
            <div class="auto-arrange-summary">
                <span>共：<strong id="testAutoArrangeTotalAthletes">0</strong> 人</span>
                <span><strong id="testAutoArrangeTotalClasses">0</strong> 级别</span>
                <span><strong id="testAutoArrangeTotalMatches">0</strong> 场</span>
            </div>
        </div>
    </div>
</div>

<!-- 手工编排模态框 -->
<div id="testManualArrangeModal" class="modal" style="display:none; position:fixed; z-index:1000; left:0; top:0; width:100%; height:100%; background-color:rgba(0,0,0,0.5);">
    <div class="modal-content" style="background-color:#fefefe; margin:5% auto; padding:20px; border:1px solid #888; width:90%; max-width:1200px; border-radius:8px; max-height:80vh; overflow-y:auto;">
        <div class="modal-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h2>手工编排对阵</h2>
            <span class="close" onclick="closeTestManualArrangeModal()" style="color:#aaa; font-size:28px; font-weight:bold; cursor:pointer;">&times;</span>
        </div>
        <div class="modal-body">
            <div class="manual-arrange-toolbar" style="margin-bottom:15px; display:flex; gap:10px; flex-wrap:wrap;">
                <select id="testManualWeightClassSelect" class="form-control" style="width:200px;" onchange="loadTestManualArrangeData()">
                    <option value="">选择级别</option>
                </select>
                <button class="btn btn-primary" onclick="saveTestManualArrange()">💾 保存手工编排</button>
                <button class="btn btn-info" onclick="clearTestManualArrange()">🔄 清空重排</button>
                <button class="btn btn-warning" onclick="autoFillTestManualArrange()">🤖 自动填充</button>
            </div>
            <div class="manual-arrange-container" style="display:flex; gap:20px;">
                <div class="athletes-panel" style="flex:1; min-width:250px;">
                    <h3>运动员列表</h3>
                    <div class="athletes-list" id="testManualAthletesList" style="border:1px solid #ddd; border-radius:4px; padding:10px; min-height:400px; max-height:500px; overflow-y:auto;">
                        <p style="color:#909399; text-align:center;">请先选择级别</p>
                    </div>
                </div>
                <div class="bracket-panel" style="flex:2;">
                    <h3>对阵表</h3>
                    <div id="testManualBracketContainer" style="border:1px solid #ddd; border-radius:4px; padding:10px; min-height:400px;">
                        <p style="color:#909399; text-align:center;">请先选择级别</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.brackets-layout {
    display: flex;
    gap: 16px;
}
.brackets-sidebar {
    width: 220px;
    min-width: 220px;
    border: 1px solid #ebeef5;
    border-radius: 4px;
    background: #fafafa;
    padding: 12px;
    max-height: calc(100vh - 260px);
    overflow-y: auto;
}
.sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    padding-bottom: 8px;
