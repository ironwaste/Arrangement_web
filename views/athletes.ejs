<div class="card">
    <div class="card-header">
        <h2>运动员管理</h2>
        <div class="toolbar" style="margin: 0;">
            <button class="btn btn-primary" onclick="showAddAthleteModal()">➕ 添加运动员</button>
            <button class="btn btn-success" onclick="showBatchAthleteModal()">📥 批量添加</button>
            <button class="btn btn-warning" onclick="doDraw(selectedClass)">🎲 抽签</button>
            <button class="btn btn-danger" onclick="clearDraw()">🗑️ 清除签号</button>
            <button class="btn btn-danger" onclick="clearAllAthletes()" style="background: #909399; border-color: #909399;">⚠️ 全部清除</button>
            <button class="btn btn-info" onclick="printAllAthletes()">🖨️ 打印全部名单</button>
            <button class="btn btn-success" onclick="exportAthletes()">📤 导出Excel</button>
            <button class="btn btn-default" onclick="loadAthletes()">🔄 刷新</button>
        </div>
    </div>
    <div class="athlete-layout">
        <aside class="class-list-panel">
            <div class="class-list-title">📋 待抽签</div>
            <ul class="class-list" id="classList"></ul>
        </aside>
        <div class="athlete-main" style="flex: 1;">
            <div class="table-container" style="max-height: calc(100vh - 300px); overflow-y: auto;">
                <table style="text-align: center; background: #C7EDCC;">
                    <thead style="position: sticky; top: 0; z-index: 1; background: linear-gradient(to right, #8B0000, #00008B);">
                        <tr>
                            <th style="text-align: center; color: #fff; background: transparent;">序号</th>
                            <th style="text-align: center; color: #fff; background: transparent;">类型</th>
                            <th style="text-align: center; color: #fff; background: transparent;">运动员号</th>
                            <th style="text-align: center; color: #fff; background: transparent;">签号</th>
                            <th style="text-align: center; color: #fff; background: transparent;">姓名</th>
                            <th style="text-align: center; color: #fff; background: transparent;">性别</th>
                            <th style="text-align: center; color: #fff; background: transparent;">单位</th>
                            <th style="text-align: center; color: #fff; background: transparent;">组别</th>
            <th style="text-align: center; color: #fff; background: transparent;">修改组别</th>
            <th style="text-align: center; color: #fff; background: transparent;">级别</th>
            <th style="text-align: center; color: #fff; background: transparent;">修改级别</th>
                            <th style="text-align: center; color: #fff; background: transparent;">操作</th>
                        </tr>
                    </thead>
                    <tbody id="athletesTable"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    // 页面初始化时恢复滚动位置
    document.addEventListener('DOMContentLoaded', function() {
        // 等待 loadAthletes 函数执行完成后再恢复滚动位置
        // loadAthletes 会在数据加载完成后调用 restoreScrollPosition
        // 这里额外确保一次，防止特殊情况
        setTimeout(function() {
            const container = document.querySelector('.table-container');
            if (container && container.scrollHeight > container.clientHeight) {
                restoreScrollPosition();
            }
        }, 500);
    });
</script>
