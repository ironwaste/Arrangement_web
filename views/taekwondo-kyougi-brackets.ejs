<div class="card">
    <div class="card-header">
        <h2>跆拳道编排</h2>
        <div class="toolbar" style="margin: 0;">
            <input type="file" id="arrangeImportFile" accept=".xls,.xlsx" style="display:none;" onchange="handleArrangeImport(event)">
            <button class="btn btn-info" onclick="document.getElementById('arrangeImportFile').click()">📥 导入数据</button>
            <button class="btn btn-warning" onclick="exportArrangeData()">📤 导出数据</button>
            <button class="btn btn-primary" onclick="saveAutoArrange()">💾 保存</button>
            <button class="btn btn-success" onclick="generateBracket()">🏆 生成对阵图</button>
            <button class="btn" style="background:#27ae60;color:white;" onclick="generateMatches()">📋 生成对阵表</button>
            <button class="btn" style="background:#8e44ad;color:white;" onclick="if(typeof JiuJitsuBrackets!=='undefined')JiuJitsuBrackets.showCompModeConfigModal()">⚙️ 竞赛方式配置</button>
        </div>
    </div>
    <div class="brackets-layout">
        <div class="brackets-sidebar">
            <div class="sidebar-header">
                <h3>📋 待编排级别</h3>
                <span id="pendingCount" class="pending-badge">0</span>
            </div>
            <div id="pendingClassList" class="pending-class-list"></div>
        </div>
        <div class="brackets-sidebar">
            <div class="sidebar-header">
                <h3>场地分配</h3>
                <div style="display:flex;gap:4px;align-items:center;">
                    <button onclick="showVenueUnitConfig()" style="font-size:11px;padding:2px 8px;border:1px solid #409EFF;border-radius:3px;background:#409EFF;cursor:pointer;color:white;" title="场地/单元配置">⚙️</button>
                    <select id="venueFilter" onchange="filterVenueAllocation()" style="font-size:12px;padding:2px 6px;border:1px solid #dcdfe6;border-radius:3px;">
                        <option value="">全部</option>
                    </select>
                    <button onclick="resetVenueFilter()" style="font-size:11px;padding:2px 8px;border:1px solid #dcdfe6;border-radius:3px;background:#fff;cursor:pointer;color:#606266;" title="重置筛选">🔄</button>
                </div>
            </div>
            <div style="margin-bottom:8px;">
                <select id="unitFilter" onchange="filterByUnit()" style="width:100%;font-size:12px;padding:4px 6px;border:1px solid #dcdfe6;border-radius:3px;">
                    <option value="">全部单元</option>
                </select>
            </div>
            <div id="venueAllocationList" class="venue-allocation-list"></div>
        </div>
        <div class="brackets-main">
            <div class="auto-arrange-table-wrapper">
                <table class="auto-arrange-table" id="bracketsTable">
                    <thead>
                        <tr>
                            <th data-col="index" style="position:relative;cursor:pointer;">序号</th>
                            <th data-col="rounds" style="position:relative;cursor:pointer;">轮次</th>
                            <th data-col="total" style="position:relative;cursor:pointer;">场次</th>
                            <th data-col="order" style="position:relative;cursor:pointer;">顺序</th>
                            <th data-col="venue" style="position:relative;cursor:pointer;">场地</th>
                            <th data-col="unit" style="position:relative;cursor:pointer;">单元</th>
                            <th data-col="compMode" style="position:relative;cursor:pointer;">竞赛方式</th>
                            <th data-col="weightClass" style="position:relative;cursor:pointer;">级别</th>
                            <th data-col="count" style="position:relative;cursor:pointer;">人数</th>
                            <th data-col="totalMatches" style="position:relative;cursor:pointer;">总场次</th>
                            <th data-col="final" style="position:relative;cursor:pointer;">Final</th>
                            <th data-col="half" style="position:relative;cursor:pointer;">1/2</th>
                            <th data-col="quarter" style="position:relative;cursor:pointer;">1/4</th>
                            <th data-col="eighth" style="position:relative;cursor:pointer;">1/8</th>
                            <th data-col="sixteenth" style="position:relative;cursor:pointer;">1/16</th>
                            <th data-col="thirtysecond" style="position:relative;cursor:pointer;">1/32</th>
                            <th data-col="sixtyfourth" style="position:relative;cursor:pointer;">1/64</th>
                            <th data-col="onetwentyeight" style="position:relative;cursor:pointer;">1/128</th>
                            <th data-col="twofiftysix" style="position:relative;cursor:pointer;">1/256</th>
                            <th data-col="gold" style="position:relative;cursor:pointer;">Gold</th>
                            <th data-col="silver" style="position:relative;cursor:pointer;">Silver</th>
                            <th data-col="bronze" style="position:relative;cursor:pointer;">Bronze</th>
                            <th data-col="rep" style="position:relative;cursor:pointer;">Rep.</th>
                            <th data-col="brom" style="position:relative;cursor:pointer;">Bro.m</th>
                        </tr>
                    </thead>
                    <tbody id="autoArrangeTableBody"></tbody>
                </table>
            </div>
            <div class="auto-arrange-summary">
                <span>共：<strong id="autoArrangeTotalAthletes">0</strong> 人</span>
                <span><strong id="autoArrangeTotalClasses">0</strong> 级别</span>
                <span><strong id="autoArrangeTotalMatches">0</strong> 场</span>
            </div>
        </div>
    </div>
</div>

<!-- 手工编排模态框 -->
<div id="manualArrangeModal" class="modal" style="display:none; position:fixed; z-index:1000; left:0; top:0; width:100%; height:100%; background-color:rgba(0,0,0,0.5);">
    <div class="modal-content" style="background-color:#fefefe; margin:5% auto; padding:20px; border:1px solid #888; width:90%; max-width:1200px; border-radius:8px; max-height:80vh; overflow-y:auto;">
        <div class="modal-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h2>手工编排对阵</h2>
            <span class="close" onclick="closeManualArrangeModal()" style="color:#aaa; font-size:28px; font-weight:bold; cursor:pointer;">&times;</span>
        </div>
        <div class="modal-body">
            <div class="manual-arrange-toolbar" style="margin-bottom:15px; display:flex; gap:10px; flex-wrap:wrap;">
                <select id="manualWeightClassSelect" class="form-control" style="width:200px;" onchange="loadManualArrangeData()">
                    <option value="">选择级别</option>
                </select>
                <button class="btn btn-primary" onclick="saveManualArrange()">💾 保存手工编排</button>
                <button class="btn btn-info" onclick="clearManualArrange()">🔄 清空重排</button>
                <button class="btn btn-warning" onclick="autoFillManualArrange()">🤖 自动填充</button>
            </div>
            <div class="manual-arrange-container" style="display:flex; gap:20px;">
                <div class="athletes-panel" style="flex:1; min-width:250px;">
                    <h3>运动员列表</h3>
                    <div class="athletes-list" id="manualAthletesList" style="border:1px solid #ddd; border-radius:4px; padding:10px; min-height:400px; max-height:500px; overflow-y:auto;">
                        <p style="color:#909399; text-align:center;">请先选择级别</p>
                    </div>
                </div>
                <div class="bracket-panel" style="flex:2;">
                    <h3>对阵表</h3>
                    <div id="manualBracketContainer" style="border:1px solid #ddd; border-radius:4px; padding:10px; min-height:400px;">
                        <p style="color:#909399; text-align:center;">请先选择级别</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
